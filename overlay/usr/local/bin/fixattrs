#!/bin/bash

# applies all files in $FIXATTRS_PATH

# fixattrs file structure, one rule per line (blank lines and lines starting with # are ignored):
# path recursive user:group fmode dmode

# fixattrs file examples:

# /root/test-dir-one false joe:joe 0755 0777
# /root/test-dir-two true joe:joe 0755 0777

# /root/test-dir-three false joe:joe 0755 0777
# /root/test-dir-four/test-file-one false joe:joe 0777 0666
# /root/test-dir-four/test-file-two true joe:joe 0666 0777

# A rule with recursive=false changes only the path itself: dmode if it is a directory, fmode if it is a file.
# The protected lists stop a typo from handing a whole system directory to someone else.
# They refuse those directories themselves, not what is under them, and are not a security boundary.

source /etc/profile.d/40-functions.sh

readonly FIXATTRS_PATH=/etc/fixattrs.d
status=0
readonly PROTECTED_ROOTS=(/proc /sys /dev /boot)
readonly PROTECTED_PATHS=(/etc /var /lib /run /bin /home /mnt /usr /sbin /lib /lib64 /usr/bin /usr/include /usr/lib /usr/local /usr/sbin /usr/share /usr/src /var/lib /var/local /var/log /var/opt /var/lock /var/run)

function is-directory {
    [[ -d "$1" ]]
}

function get-root {
    echo "$1" | cut -d'/' -f2
}

function normalize-path {
    echo "$1" | sed 's/\/$//'
}

function path-is-root {
    [[ $1 = '/' ]]
}

function path-is-protected-root {
    local path="$1"
    local root
    root=$(get-root "$path")
    local dir
    for dir in "${PROTECTED_ROOTS[@]}"; do
        dir=$(get-root "$dir")
        if [[ $dir = "$root" ]]; then
            return 0
        fi
    done
    return 1
}

function path-is-protected {
    local path
    path=$(normalize-path "$1")
    local dir
    for dir in "${PROTECTED_PATHS[@]}"; do
        if [[ $dir = "$path" ]]; then
            return 0
        fi
    done
    return 1
}

function path-is-sane {
    local path="$1"
    if [[ -z $path ]]; then
        return 1
    elif path-is-root "$path"; then
        log::m-warn "path: $path is root, skipping ..."
        return 1
    elif path-is-protected-root "$path"; then
        log::m-warn "path: $path is a protected root directory, skipping ..."
        return 1
    elif path-is-protected "$path"; then
        log::m-warn "path: $path is a protected path, skipping ..."
        return 1
    elif [[ ! -e $path ]]; then
        log::m-warn "path: $path doesn't exist, skipping ..."
        return 1
    else
        return 0
    fi
}

function rule-is-valid {
    local recursive="$1"
    local owner="$2"
    local fmode="$3"
    local dmode="$4"
    [[ $recursive =~ ^(true|false)$ ]] \
        && [[ $owner =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*(:[A-Za-z0-9_][A-Za-z0-9_.-]*)?$ ]] \
        && [[ $fmode =~ ^[0-7]{3,4}$ ]] \
        && [[ $dmode =~ ^[0-7]{3,4}$ ]]
}

function set-ownership {
    local path="$1"
    local recursive="$2"
    local owner="$3"

    local cmd=(chown)

    [[ $recursive = true ]] \
        && cmd+=(-R)
    cmd+=(-- "$owner" "$path")
    "${cmd[@]}" || status=1
}

function set-permissions {
    local path="$1"
    local recursive="$2"
    local fmode="$3"
    local dmode="$4"

    local depth=()
    [[ $recursive = true ]] || depth=(-maxdepth 0)

    find "$path" "${depth[@]}" -type d -exec chmod "$dmode" {} \+ || status=1
    find "$path" "${depth[@]}" -type f -exec chmod "$fmode" {} \+ || status=1
}

function log-msg {
    local path="$1"
    local recursive="$2"
    local owner="$3"
    local fmode="$4"
    local dmode="$5"
    local msg
    msg+="  $path "
    if [[ $recursive = true ]]; then
        msg+='recurse '
    fi
    msg+="o:$owner f:$fmode d:$dmode"
    log::m-info "$msg"
}

function apply-file {
    local file="$1"
    local path recursive owner fmode dmode extra
    log::m-info ": $file"
    while read -r path recursive owner fmode dmode extra || [[ -n $path ]]; do
        [[ -z $path || $path == \#* ]] && continue
        if [[ -n $extra ]] || ! rule-is-valid "$recursive" "$owner" "$fmode" "$dmode"; then
            log::m-warn "  malformed rule, skipping: $path $recursive $owner $fmode $dmode $extra"
            status=1
            continue
        fi
        path="${path/#\~/"$HOME"}"
        path=$(realpath -m -- "$path") || { status=1; continue; }
        if path-is-sane "$path"; then
            log-msg "$path" "$recursive" "$owner" "$fmode" "$dmode"
            set-ownership "$path" "$recursive" "$owner"
            set-permissions "$path" "$recursive" "$fmode" "$dmode"
        elif [[ ! -e $path ]]; then
            status=1
        fi
    done <"$file"
}

function main {
    local file files
    shopt -s nullglob
    if ! is-directory "$FIXATTRS_PATH"; then
        log::m-warn "$FIXATTRS_PATH doesn't exist, no ownerships or permissions to apply"
        return
    fi
    files=("$FIXATTRS_PATH"/*)
    if ((${#files[@]} == 0)); then
        log::m-warn "$FIXATTRS_PATH is empty, no ownerships or permissions to apply"
        return
    fi
    log::m-info "Applying ownership and permission fixes ..."
    for file in "${files[@]}"; do
        if [[ -f $file ]]; then
            apply-file "$file" || status=1
        else
            log::m-warn "$file is not a regular file, skipping ..."
            status=1
        fi
    done
    echo
}

main
exit $status
